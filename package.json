{
  "name": "suprise",
  "homepage": "https://fighii.github.io/birthday-surprise/",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "lint": "oxlint",
    "preview": "vite preview",
    "git:sync": "git add -A && git commit -m \"auto sync\" --allow-empty && git push origin main",
    "sync": "npm run git:sync && npm run deploy",
    "tunnel": "ngrok http 5199 --url https://",
    "dev:tunnel": "concurrently -k -n vite,ngrok -c blue,magenta \"npm run dev\" \"wait-on tcp:127.0.0.1:5199 && ngrok http 5199 --url https://\"",
    "share": "npm run dev:tunnel"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "fluent-ffmpeg": "^2.1.3",
    "gh-pages": "^6.3.0",
    "ngrok": "^5.0.0-beta.2",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  }
}
